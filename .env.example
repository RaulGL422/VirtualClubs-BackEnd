# ──────────────────────────────────────────────
# Active profile: dev | prod
# ──────────────────────────────────────────────
SPRING_PROFILE_ACTIVE=dev
PORT=8080

# ──────────────────────────────────────────────
# PostgreSQL database (dev profile)
# ──────────────────────────────────────────────
URL_DATABASE_POSTGRES_DEBUG=localhost
PORT_DATABASE_POSTGRES_DEBUG=5432
NAME_DATABASE_POSTGRES_DEBUG=virtualclubs
USERNAME_DATABASE_POSTGRES_DEBUG=postgres
PASSWORD_DATABASE_POSTGRES_DEBUG=

# ──────────────────────────────────────────────
# JWT — HMAC-SHA256 secret key, minimum 32 characters
# ──────────────────────────────────────────────
JWT_SECRET_DEBUG=

# ──────────────────────────────────────────────
# Google OAuth2
# Get your Client ID at: https://console.cloud.google.com
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID_DEBUG=xxxx.apps.googleusercontent.com

# ──────────────────────────────────────────────
# Resend — transactional email delivery
# Get your API key at: https://resend.com
# ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxx

# ──────────────────────────────────────────────
# API base URL (optional — defaults to http://localhost:8080)
# Used for email links and deep-link redirects
# ──────────────────────────────────────────────
API_BASE_URL_DEBUG=