# ──────────────────────────────────────────────
# Perfil activo: dev | prod
# ──────────────────────────────────────────────
SPRING_PROFILE_ACTIVE=dev
PORT=4584

# ──────────────────────────────────────────────
# Base de datos PostgreSQL (perfil dev)
# ──────────────────────────────────────────────
URL_DATABASE_POSTGRES_DEBUG=localhost
PORT_DATABASE_POSTGRES_DEBUG=5432
NAME_DATABASE_POSTGRES_DEBUG=virtualclubs
USERNAME_DATABASE_POSTGRES_DEBUG=postgres
PASSWORD_DATABASE_POSTGRES_DEBUG=

# ──────────────────────────────────────────────
# JWT — clave HMAC-SHA256, mínimo 32 caracteres
# ──────────────────────────────────────────────
JWT_SECRET_DEBUG=

# ──────────────────────────────────────────────
# Google OAuth2
# Obtén el Client ID en: https://console.cloud.google.com
# ──────────────────────────────────────────────
GOOGLE_CONTENT_ID_DEBUG=xxxx.apps.googleusercontent.com

# ──────────────────────────────────────────────
# Resend — envío de emails transaccionales
# Obtén la API key en: https://resend.com
# ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxx