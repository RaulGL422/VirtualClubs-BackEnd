# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

*.env

# Certificates and keystores
*.p12
*.jks
*.pem
*.key

# IntelliJ IDEA
.idea/
*.iml
*.iws

# Maven build output
target/

# Claude Code — configuración personal (no del equipo)
.claude/settings.local.json

# Tests de conectividad manual (no forman parte de la suite automática)
src/test/java/**/EmailConnectivityTest.java

# graphify — artefactos de build puros (cache de extraccion, contador de tokens)
graphify-out/cache/
graphify-out/cost.json

# graphify — backups fechados del grafo previos a cada update (solo red de seguridad local)
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify — rutas locales de esta máquina (intérprete Python, raíz absoluta);
# no portables entre contribuidores ni válidas para el runner de CI
graphify-out/.graphify_python
graphify-out/.graphify_root

